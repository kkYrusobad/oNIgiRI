#!/bin/bash
# Random wallpaper setter for Niruv - uses awww with transitions

WALLPAPER_DIR="${HOME}/Pictures/Wallpapers"

# Start awww daemon if not already running
if ! awww query &>/dev/null; then
    awww-daemon --no-cache &
    sleep 0.5
fi

# Find a random wallpaper
WALL=$(find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n 1)

# Set wallpaper with transition if found
if [ -n "$WALL" ]; then
    awww img "$WALL" \
        --transition-type center \
        --transition-step 100 \
        --transition-fps 165
fi
