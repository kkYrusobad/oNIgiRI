#!/bin/bash

# niri-apps-menu: App launcher using fuzzel's native drun mode
# Fast, simple, with Noctalia styling

exec fuzzel \
    --font="JetBrainsMono Nerd Font:size=12" \
    --background=282828e6 \
    --text-color=fbf1c7ff \
    --selection-color=3c3836e6 \
    --selection-text-color=b8bb26ff \
    --border-color=57514eff \
    --match-color=fabd2fff \
    --horizontal-pad=16 \
    --vertical-pad=12 \
    --inner-pad=8 \
    --icon-theme=Papirus \
    --width=50 \
    --lines=15 \
    --prompt=" 󰀻 Apps  "
